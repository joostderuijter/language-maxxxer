{
  "extends": "$app/tsconfig",
  "include": ["src", "e2e", "*"],
  "exclude": ["src/service-worker"],
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "types": ["$app/types", "node", "vitest/globals", "@testing-library/jest-dom"]
  }
}
