{
  "openapi": "3.1.0",
  "info": {
    "title": "language-maxxer",
    "version": "0.1.0"
  },
  "paths": {
    "/api/library/status": {
      "get": {
        "summary": "Status",
        "operationId": "status_api_library_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LibraryStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/library/sync": {
      "post": {
        "summary": "Sync Now",
        "operationId": "sync_now_api_library_sync_post",
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "boolean"
                  },
                  "type": "object",
                  "title": "Response Sync Now Api Library Sync Post"
                }
              }
            }
          }
        }
      }
    },
    "/api/library/series": {
      "get": {
        "summary": "Series",
        "description": "All shows, from the stats cache (instant; may lag a moment behind a knowledge change).",
        "operationId": "series_api_library_series_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SeriesOut"
                  },
                  "type": "array",
                  "title": "Response Series Api Library Series Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/library/series/{key}": {
      "get": {
        "summary": "Series Items",
        "description": "One show's episodes with LIVE stats (fast per show).",
        "operationId": "series_items_api_library_series__key__get",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ItemOut"
                  },
                  "title": "Response Series Items Api Library Series  Key  Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/library/items/{item_id}/words": {
      "get": {
        "summary": "Item Words",
        "operationId": "item_words_api_library_items__item_id__words_get",
        "parameters": [
          {
            "name": "item_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Item Id"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/NewWordOut"
                  },
                  "title": "Response Item Words Api Library Items  Item Id  Words Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/library/next": {
      "get": {
        "summary": "Next Up",
        "description": "What to watch next (ADR-13): analysed, unwatched episodes closest to your level, with the reasons.",
        "operationId": "next_up_api_library_next_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "default": 5,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/NextOut"
                  },
                  "title": "Response Next Up Api Library Next Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/languages": {
      "get": {
        "summary": "List Languages",
        "operationId": "list_languages_api_languages_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Language"
                  },
                  "type": "array",
                  "title": "Response List Languages Api Languages Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/dictionary/{code}": {
      "get": {
        "summary": "Lookup",
        "description": "Meanings of the first candidate lemma the dictionary knows (a token's lemmas, most specific first).",
        "operationId": "lookup_api_dictionary__code__get",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Code"
            }
          },
          {
            "name": "lemma",
            "in": "query",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "maxItems": 10,
              "title": "Lemma"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LookupResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/progress/{code}": {
      "get": {
        "summary": "Progress",
        "operationId": "progress_api_progress__code__get",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Code"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Progress"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/analyze": {
      "post": {
        "summary": "Analyze",
        "operationId": "analyze_api_analyze_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyzeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyzeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/knowledge/events": {
      "post": {
        "summary": "Add Event",
        "operationId": "add_event_api_knowledge_events_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EventRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WordStatus"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/knowledge/import": {
      "post": {
        "summary": "Import Words",
        "operationId": "import_words_api_knowledge_import_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImportRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnalyzeRequest": {
        "properties": {
          "language": {
            "type": "string",
            "title": "Language",
            "examples": [
              "ko"
            ]
          },
          "text": {
            "type": "string",
            "maxLength": 20000,
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "language",
          "text"
        ],
        "title": "AnalyzeRequest"
      },
      "AnalyzeResponse": {
        "properties": {
          "language": {
            "type": "string",
            "title": "Language"
          },
          "tokens": {
            "items": {
              "$ref": "#/components/schemas/AnalyzedToken"
            },
            "type": "array",
            "title": "Tokens"
          },
          "sentences": {
            "items": {
              "$ref": "#/components/schemas/SentenceOut"
            },
            "type": "array",
            "title": "Sentences"
          }
        },
        "type": "object",
        "required": [
          "language",
          "tokens",
          "sentences"
        ],
        "title": "AnalyzeResponse"
      },
      "AnalyzedToken": {
        "properties": {
          "surface": {
            "type": "string",
            "title": "Surface"
          },
          "start": {
            "type": "integer",
            "title": "Start"
          },
          "end": {
            "type": "integer",
            "title": "End"
          },
          "lemmas": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Lemmas"
          },
          "pos": {
            "type": "string",
            "title": "Pos"
          },
          "key": {
            "type": "string",
            "title": "Key"
          },
          "weak": {
            "type": "boolean",
            "title": "Weak"
          },
          "state": {
            "$ref": "#/components/schemas/WordState"
          },
          "lemma": {
            "type": "string",
            "title": "Lemma"
          }
        },
        "type": "object",
        "required": [
          "surface",
          "start",
          "end",
          "lemmas",
          "pos",
          "key",
          "weak",
          "state",
          "lemma"
        ],
        "title": "AnalyzedToken"
      },
      "EventKind": {
        "type": "string",
        "enum": [
          "marked_known",
          "marked_unknown",
          "ignored",
          "seen",
          "card_added",
          "mature",
          "lapsed",
          "quiz_right",
          "quiz_wrong"
        ],
        "title": "EventKind"
      },
      "EventRequest": {
        "properties": {
          "language": {
            "type": "string",
            "title": "Language"
          },
          "lemma": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Lemma"
          },
          "kind": {
            "$ref": "#/components/schemas/EventKind"
          }
        },
        "type": "object",
        "required": [
          "language",
          "lemma",
          "kind"
        ],
        "title": "EventRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "ok",
          "version"
        ],
        "title": "Health"
      },
      "IdiomOut": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "gloss": {
            "type": "string",
            "title": "Gloss"
          },
          "definition": {
            "type": "string",
            "title": "Definition"
          },
          "native": {
            "type": "string",
            "title": "Native"
          }
        },
        "type": "object",
        "required": [
          "text",
          "kind",
          "gloss",
          "definition",
          "native"
        ],
        "title": "IdiomOut"
      },
      "ImportRequest": {
        "properties": {
          "language": {
            "type": "string",
            "title": "Language"
          },
          "csv": {
            "type": "string",
            "title": "Csv",
            "description": "lines \"lemma,state\"; state = known|learning|seen|ignored|unknown, or the Migaku-style numbers 2=known 1=seen 0=learning 3=ignored"
          },
          "source": {
            "type": "string",
            "maxLength": 64,
            "title": "Source",
            "default": "import:csv"
          }
        },
        "type": "object",
        "required": [
          "language",
          "csv"
        ],
        "title": "ImportRequest"
      },
      "ImportResult": {
        "properties": {
          "imported": {
            "type": "integer",
            "title": "Imported"
          },
          "skipped": {
            "type": "integer",
            "title": "Skipped"
          }
        },
        "type": "object",
        "required": [
          "imported",
          "skipped"
        ],
        "title": "ImportResult"
      },
      "ItemOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "series": {
            "type": "string",
            "title": "Series"
          },
          "season": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Season"
          },
          "episode": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Episode"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "subtitle": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subtitle"
          },
          "duration_s": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration S"
          },
          "coverage": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Coverage"
          },
          "new_words": {
            "type": "integer",
            "title": "New Words"
          },
          "one_new": {
            "type": "integer",
            "title": "One New"
          },
          "sentences": {
            "type": "integer",
            "title": "Sentences"
          }
        },
        "type": "object",
        "required": [
          "id",
          "series",
          "season",
          "episode",
          "title",
          "status",
          "subtitle",
          "duration_s",
          "coverage",
          "new_words",
          "one_new",
          "sentences"
        ],
        "title": "ItemOut"
      },
      "Language": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "dictionary": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Dictionary"
          }
        },
        "type": "object",
        "required": [
          "code",
          "name",
          "dictionary"
        ],
        "title": "Language"
      },
      "LibraryStatus": {
        "properties": {
          "enabled": {
            "type": "boolean",
            "title": "Enabled"
          },
          "running": {
            "type": "boolean",
            "title": "Running"
          },
          "last_sync": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Sync"
          },
          "analysed": {
            "type": "integer",
            "title": "Analysed"
          },
          "current": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "items": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Items"
          },
          "stats_pending": {
            "type": "integer",
            "title": "Stats Pending"
          }
        },
        "type": "object",
        "required": [
          "enabled",
          "running",
          "last_sync",
          "analysed",
          "current",
          "error",
          "items",
          "stats_pending"
        ],
        "title": "LibraryStatus"
      },
      "LookupResponse": {
        "properties": {
          "lemma": {
            "type": "string",
            "title": "Lemma"
          },
          "senses": {
            "items": {
              "$ref": "#/components/schemas/SenseOut"
            },
            "type": "array",
            "title": "Senses"
          },
          "idioms": {
            "items": {
              "$ref": "#/components/schemas/IdiomOut"
            },
            "type": "array",
            "title": "Idioms"
          }
        },
        "type": "object",
        "required": [
          "lemma",
          "senses",
          "idioms"
        ],
        "title": "LookupResponse"
      },
      "NewWordOut": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key"
          },
          "lemmas": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Lemmas"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          },
          "state": {
            "type": "string",
            "title": "State"
          }
        },
        "type": "object",
        "required": [
          "key",
          "lemmas",
          "count",
          "state"
        ],
        "title": "NewWordOut"
      },
      "NextOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "series": {
            "type": "string",
            "title": "Series"
          },
          "series_key": {
            "type": "string",
            "title": "Series Key"
          },
          "season": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Season"
          },
          "episode": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Episode"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "coverage": {
            "type": "number",
            "title": "Coverage"
          },
          "new_words": {
            "type": "integer",
            "title": "New Words"
          },
          "one_new": {
            "type": "integer",
            "title": "One New"
          },
          "score": {
            "type": "number",
            "title": "Score"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Reasons"
          },
          "open_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Open Url"
          }
        },
        "type": "object",
        "required": [
          "id",
          "series",
          "series_key",
          "season",
          "episode",
          "title",
          "coverage",
          "new_words",
          "one_new",
          "score",
          "reasons",
          "open_url"
        ],
        "title": "NextOut"
      },
      "Progress": {
        "properties": {
          "language": {
            "type": "string",
            "title": "Language"
          },
          "words_known": {
            "type": "integer",
            "title": "Words Known"
          },
          "by_state": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "By State"
          }
        },
        "type": "object",
        "required": [
          "language",
          "words_known",
          "by_state"
        ],
        "title": "Progress"
      },
      "SenseOut": {
        "properties": {
          "headword": {
            "type": "string",
            "title": "Headword"
          },
          "pos": {
            "type": "string",
            "title": "Pos"
          },
          "gloss": {
            "type": "string",
            "title": "Gloss"
